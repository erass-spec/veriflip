# Frontend environment (Next.js). Copy to .env.local for local builds; set the same
# vars in your Vercel project. .env.local is gitignored.

# CoinFlip address on Sepolia — printed by `npm run deploy:sepolia`.
NEXT_PUBLIC_SEPOLIA_ADDRESS=

# Testnet-only burner that powers one-click "Instant Play" on the PUBLIC demo.
# Generated by `npm run keygen`. Intentionally exposed in the client bundle —
# testnet only, low maxBet. See docs/security_review.md. Leave empty for local dev
# (Instant Play falls back to the local Hardhat burner).
NEXT_PUBLIC_SEPOLIA_BURNER_KEY=

# Optional RPC overrides (sensible public defaults are used otherwise).
# NEXT_PUBLIC_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
# NEXT_PUBLIC_LOCAL_RPC=http://127.0.0.1:8545
