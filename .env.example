# --- Sepolia deployment (Phase II) ---
# RPC endpoint — use Alchemy/Infura for reliability, or the public fallback.
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Deployer private key. NEVER commit the real .env. Generated via `npm run keygen`.
# Only the PUBLIC address is ever logged to project_state.json.
DEPLOYER_PRIVATE_KEY=

# Optional — for contract source verification on Etherscan.
ETHERSCAN_API_KEY=
